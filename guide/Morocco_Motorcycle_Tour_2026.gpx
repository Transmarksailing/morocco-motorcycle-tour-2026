<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Morocco Motorcycle Tour 2026 - Moraira to the Sahara" xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Morocco Motorcycle Tour 2026 - Moraira to the Sahara</name>
    <desc>10 riding days in Morocco + Spanish transit. Ferry Almeria-Nador. Rif, Middle Atlas, Sahara (Merzouga), Todra and Dades gorges, Ait Benhaddou, Marrakech, Tizi n'Tichka, Ouzoud. 2x BMW R1250GS + 1x Tenere 700 World Raid. Oct 2026.</desc>
  </metadata>

  <!-- ============ WAYPOINTS ============ -->
  <wpt lat="38.6873" lon="0.1440"><name>START/END Moraira</name><sym>Residence</sym><desc>Departure 11 Oct, return 22 Oct.</desc></wpt>
  <wpt lat="36.8300" lon="-2.4640"><name>Almeria port (FERRY)</name><sym>Anchor</sym><desc>Night ferry to Nador (Balearia/Trasmediterranea). Arrive in good time.</desc></wpt>
  <wpt lat="35.2680" lon="-2.9330"><name>Nador - Beni Ansar port (FERRY)</name><sym>Anchor</sym><desc>Arrival Morocco. Allow 1-2h border formalities + temporary vehicle import.</desc></wpt>
  <wpt lat="34.2270" lon="-3.3530"><name>Guercif (NIGHT 1) + lunch/fuel day 10</name><sym>Lodging</sym><desc>Hotel Atlas Guercif (underground parking). Fill up here on the way back.</desc></wpt>
  <wpt lat="32.6800" lon="-4.7450"><name>Midelt - Moonrise Villa VIP (NIGHTS 2,3; N9 to book)</name><sym>Lodging</sym><desc>Moonrise Villa VIP Midelt (BOOKED nights 2,3, free private parking). Night 9 still to book.</desc></wpt>
  <wpt lat="33.5228" lon="-5.1106"><name>Ifrane</name><sym>Scenic Area</sym><desc>Switzerland of Morocco. Coffee stop day 3.</desc></wpt>
  <wpt lat="33.4270" lon="-5.1720"><name>Cedar forest Azrou (Barbary macaques)</name><sym>Forest</sym><desc>Cedar and pine forest, chance of wild monkeys. Day 3.</desc></wpt>
  <wpt lat="33.4342" lon="-5.2214"><name>Azrou - lunch</name><sym>Restaurant</sym><desc>Market town, lunch stop day 3.</desc></wpt>
  <wpt lat="31.9314" lon="-4.4244"><name>Errachidia</name><sym>City (Small)</sym><desc>Gateway to the Ziz Valley.</desc></wpt>
  <wpt lat="31.6870" lon="-4.2570"><name>Ziz Valley - Aoufous (N13)</name><sym>Scenic Area</sym><desc>Palm ribbon between red cliffs, on the N13. Transition mountains to desert. Day 4.</desc></wpt>
  <wpt lat="31.0990" lon="-4.0130"><name>Merzouga - Erg Chebbi (NIGHT 4)</name><sym>Summit</sym><desc>Sand dunes up to 150m. Kasbah Mohayut: parking inside the kasbah. Sunset on the dunes. Do NOT ride laden bikes into soft sand.</desc></wpt>
  <wpt lat="31.2810" lon="-4.2600"><name>Rissani - souk</name><sym>Shopping Center</sym><desc>Old caravan town, market Sun/Tue/Thu. Day 5.</desc></wpt>
  <wpt lat="31.5900" lon="-5.6000"><name>Todra Gorge</name><sym>Scenic Area</sym><desc>Gorge walls up to 300m sheer. Ride through + photo stop. Day 5.</desc></wpt>
  <wpt lat="31.3690" lon="-5.9910"><name>Boumalne Dades - Riad Des Vieilles Charrues (NIGHT 5)</name><sym>Lodging</sym><desc>Dades Gorge. Riad Des Vieilles Charrues (BOOKED), 24 km up the R704 hairpins road. Confirm bike parking.</desc></wpt>
  <wpt lat="31.5560" lon="-5.9700"><name>Dades hairpins (R704)</name><sym>Summit</sym><desc>Unforgettable hairpin bends against the red rock wall. Ride in and back. Day 6.</desc></wpt>
  <wpt lat="30.9200" lon="-6.8930"><name>Ouarzazate - fuel + lunch</name><sym>Gas Station</sym><desc>Hollywood of Morocco. Fill up day 6.</desc></wpt>
  <wpt lat="31.0472" lon="-7.1290"><name>Ait Benhaddou (NIGHT 6) - UNESCO</name><sym>Lodging</sym><desc>Famous mud-brick ksar, film set. Riad Tamdakhte (BOOKED, Tamdakht 5 km, parking). Arrive golden hour.</desc></wpt>
  <wpt lat="31.2870" lon="-7.2400"><name>Kasbah Telouet (optional)</name><sym>Building</sym><desc>Hidden Glaoui kasbah, side road off Tizi n'Tichka. Day 7.</desc></wpt>
  <wpt lat="31.2960" lon="-7.3810"><name>Tizi n'Tichka pass - 2260m</name><sym>Summit</sym><desc>Highest tarmac pass of the trip. Classic High Atlas bends. Dress warmly. Day 7.</desc></wpt>
  <wpt lat="31.6258" lon="-7.9891"><name>Marrakech - Jemaa el-Fna (NIGHT 7)</name><sym>Lodging</sym><desc>Riad Le Perroquet Bleu (BOOKED, medina): arrange guarded parking (parking gardienne), not the alleys.</desc></wpt>
  <wpt lat="32.0155" lon="-6.7197"><name>Ouzoud waterfalls</name><sym>Waterfall</sym><desc>Highest waterfalls in Morocco (110m), monkeys, lunch. Day 8.</desc></wpt>
  <wpt lat="32.3373" lon="-6.3498"><name>Beni Mellal (NIGHT 8)</name><sym>Lodging</sym><desc>Hotel Velsatis (BOOKED), central Beni Mellal.</desc></wpt>
  <wpt lat="32.9350" lon="-5.6680"><name>Khenifra - coffee/lunch</name><sym>Restaurant</sym><desc>En route day 9.</desc></wpt>
  <wpt lat="33.0470" lon="-3.9890"><name>Missour - coffee stop</name><sym>Restaurant</sym><desc>Last Moroccan coffee. Day 10.</desc></wpt>

  <!-- ============ TRANSIT (11 Oct): Moraira -> Almeria + ferry ============ -->
  <rte>
    <name>Transit (11 Oct) Moraira - Almeria + night ferry</name>
    <desc>Approx 400 km, 4.5h. Coast/inland to the port. Evening/night ferry to Nador.</desc>
    <rtept lat="38.6873" lon="0.1440"><name>Moraira</name></rtept>
    <rtept lat="38.3452" lon="-0.4810"><name>Alicante (coast)</name></rtept>
    <rtept lat="37.9922" lon="-1.1307"><name>Murcia</name></rtept>
    <rtept lat="36.8300" lon="-2.4640"><name>Almeria port</name></rtept>
  </rte>

  <!-- ============ DAY 1 (12 Oct): Nador -> Guercif ============ -->
  <rte>
    <name>Day 1 (12 Oct) Nador - Guercif</name>
    <desc>202 km. Border Beni Ansar, then Rif foothills southward. Relaxed first day.</desc>
    <rtept lat="35.2680" lon="-2.9330"><name>Nador port (Beni Ansar)</name></rtept>
    <rtept lat="34.9130" lon="-2.9420"><name>Selouane</name></rtept>
    <rtept lat="34.4127" lon="-2.8942"><name>Taourirt</name></rtept>
    <rtept lat="34.2270" lon="-3.3530"><name>Guercif</name></rtept>
  </rte>

  <!-- ============ DAY 2 (13 Oct): Guercif -> Midelt (N15) ============ -->
  <rte>
    <name>Day 2 (13 Oct) Guercif - Midelt (N15)</name>
    <desc>238 km. Favourite road N15: flowing, quiet, climbing mountain landscape.</desc>
    <rtept lat="34.2270" lon="-3.3530"><name>Guercif</name></rtept>
    <rtept lat="33.3417" lon="-3.6903"><name>Outat El Haj (N15)</name></rtept>
    <rtept lat="33.0470" lon="-3.9890"><name>Missour</name></rtept>
    <rtept lat="32.6800" lon="-4.7450"><name>Midelt - Moonrise Villa VIP</name></rtept>
  </rte>

  <!-- ============ DAY 3 (14 Oct): Midelt -> Ifrane -> Azrou -> Midelt (loop) ============ -->
  <rte>
    <name>Day 3 (14 Oct) Midelt - Ifrane - Azrou - Midelt (loop)</name>
    <desc>285 km loop without luggage. Cedar forest, monkeys, Ifrane. Back to Moonrise Villa VIP Midelt.</desc>
    <rtept lat="32.6800" lon="-4.7450"><name>Midelt</name></rtept>
    <rtept lat="33.2350" lon="-5.0600"><name>Timahdite (N13)</name></rtept>
    <rtept lat="33.4342" lon="-5.2214"><name>Azrou</name></rtept>
    <rtept lat="33.5228" lon="-5.1106"><name>Ifrane</name></rtept>
    <rtept lat="33.4342" lon="-5.2214"><name>Azrou (lunch)</name></rtept>
    <rtept lat="32.6800" lon="-4.7450"><name>Midelt - Moonrise Villa VIP</name></rtept>
  </rte>

  <!-- ============ DAY 4 (15 Oct): Midelt -> Ziz -> Merzouga ============ -->
  <rte>
    <name>Day 4 (15 Oct) Midelt - Ziz Valley - Merzouga</name>
    <desc>285 km. N13 through the Ziz Valley into the Sahara. Arrive Erg Chebbi before sunset. Fill up!</desc>
    <rtept lat="32.6800" lon="-4.7450"><name>Midelt</name></rtept>
    <rtept lat="32.2578" lon="-4.5060"><name>Rich (N13, Tunnel du Legionnaire)</name></rtept>
    <rtept lat="31.9314" lon="-4.4244"><name>Errachidia</name></rtept>
    <rtept lat="31.6870" lon="-4.2570"><name>Ziz Valley - Aoufous (N13)</name></rtept>
    <rtept lat="31.4370" lon="-4.2380"><name>Erfoud</name></rtept>
    <rtept lat="31.0990" lon="-4.0130"><name>Merzouga - Erg Chebbi</name></rtept>
  </rte>

  <!-- ============ DAY 5 (16 Oct): Merzouga -> Todra -> Dades ============ -->
  <rte>
    <name>Day 5 (16 Oct) Merzouga - Todra Gorge - Dades</name>
    <desc>275 km. Rissani souk, Todra Gorge, overnight in the Dades Gorge.</desc>
    <rtept lat="31.0990" lon="-4.0130"><name>Merzouga</name></rtept>
    <rtept lat="31.2810" lon="-4.2600"><name>Rissani - souk</name></rtept>
    <rtept lat="31.5147" lon="-5.5326"><name>Tinghir</name></rtept>
    <rtept lat="31.5900" lon="-5.6000"><name>Todra Gorge</name></rtept>
    <rtept lat="31.5147" lon="-5.5326"><name>Tinghir (back)</name></rtept>
    <rtept lat="31.3690" lon="-5.9910"><name>Boumalne Dades</name></rtept>
  </rte>

  <!-- ============ DAY 6 (17 Oct): Dades (R704) -> Ouarzazate -> Ait Benhaddou ============ -->
  <rte>
    <name>Day 6 (17 Oct) Dades hairpins - Ouarzazate - Ait Benhaddou</name>
    <desc>215 km. R704 hairpins in and back, then via Ouarzazate to the UNESCO ksar.</desc>
    <rtept lat="31.3690" lon="-5.9910"><name>Boumalne Dades</name></rtept>
    <rtept lat="31.5560" lon="-5.9700"><name>Dades hairpins (R704)</name></rtept>
    <rtept lat="31.3690" lon="-5.9910"><name>Boumalne (back)</name></rtept>
    <rtept lat="31.2160" lon="-6.4180"><name>Skoura (palm oasis)</name></rtept>
    <rtept lat="30.9200" lon="-6.8930"><name>Ouarzazate - fuel + lunch</name></rtept>
    <rtept lat="31.0472" lon="-7.1290"><name>Ait Benhaddou</name></rtept>
  </rte>

  <!-- ============ DAY 7 (18 Oct): Ait Benhaddou -> Tizi n'Tichka -> Marrakech ============ -->
  <rte>
    <name>Day 7 (18 Oct) Ait Benhaddou - Tizi n'Tichka - Marrakech</name>
    <desc>195 km. Highest pass of the trip (2260m). Dress warmly. Ride defensively in Marrakech.</desc>
    <rtept lat="31.0472" lon="-7.1290"><name>Ait Benhaddou</name></rtept>
    <rtept lat="31.2870" lon="-7.2400"><name>Kasbah Telouet (optional)</name></rtept>
    <rtept lat="31.2960" lon="-7.3810"><name>Tizi n'Tichka pass 2260m</name></rtept>
    <rtept lat="31.4670" lon="-7.6580"><name>Taddert</name></rtept>
    <rtept lat="31.6258" lon="-7.9891"><name>Marrakech - medina</name></rtept>
  </rte>

  <!-- ============ DAY 8 (19 Oct): Marrakech -> Ouzoud -> Beni Mellal ============ -->
  <rte>
    <name>Day 8 (19 Oct) Marrakech - Ouzoud - Beni Mellal</name>
    <desc>205 km. Highest waterfalls in Morocco, then on to Beni Mellal.</desc>
    <rtept lat="31.6258" lon="-7.9891"><name>Marrakech</name></rtept>
    <rtept lat="31.7270" lon="-7.0370"><name>Demnate</name></rtept>
    <rtept lat="32.0155" lon="-6.7197"><name>Ouzoud waterfalls</name></rtept>
    <rtept lat="32.2340" lon="-6.4900"><name>Afourer</name></rtept>
    <rtept lat="32.3373" lon="-6.3498"><name>Beni Mellal</name></rtept>
  </rte>

  <!-- ============ DAY 9 (20 Oct): Beni Mellal -> Midelt ============ -->
  <rte>
    <name>Day 9 (20 Oct) Beni Mellal - Khenifra - Midelt</name>
    <desc>285 km. Wooded Middle Atlas roads back to Moonrise Villa VIP Midelt.</desc>
    <rtept lat="32.3373" lon="-6.3498"><name>Beni Mellal</name></rtept>
    <rtept lat="32.5980" lon="-6.2680"><name>Kasba Tadla</name></rtept>
    <rtept lat="32.9350" lon="-5.6680"><name>Khenifra - lunch</name></rtept>
    <rtept lat="32.6800" lon="-4.7450"><name>Midelt - Moonrise Villa VIP</name></rtept>
  </rte>

  <!-- ============ DAY 10 (21 Oct): Midelt -> Nador + ferry ============ -->
  <rte>
    <name>Day 10 (21 Oct) Midelt - Missour - Guercif - Nador + ferry</name>
    <desc>335 km, N15/N2. Early start 07:30. Fill up in Guercif. Be at terminal min. 3h before departure.</desc>
    <rtept lat="32.6800" lon="-4.7450"><name>Midelt</name></rtept>
    <rtept lat="33.0470" lon="-3.9890"><name>Missour - coffee</name></rtept>
    <rtept lat="34.2270" lon="-3.3530"><name>Guercif - lunch + fuel</name></rtept>
    <rtept lat="34.4127" lon="-2.8942"><name>Taourirt</name></rtept>
    <rtept lat="34.9130" lon="-2.9420"><name>Selouane</name></rtept>
    <rtept lat="35.2680" lon="-2.9330"><name>Nador port (Beni Ansar) - FERRY</name></rtept>
  </rte>

  <!-- ============ TRANSIT (22 Oct): Almeria -> Moraira ============ -->
  <rte>
    <name>Transit (22 Oct) Almeria - Moraira</name>
    <desc>Approx 400 km, 4.5h. Relaxed final leg along the coast back home.</desc>
    <rtept lat="36.8300" lon="-2.4640"><name>Almeria port</name></rtept>
    <rtept lat="37.9922" lon="-1.1307"><name>Murcia</name></rtept>
    <rtept lat="38.3452" lon="-0.4810"><name>Alicante</name></rtept>
    <rtept lat="38.6873" lon="0.1440"><name>Moraira</name></rtept>
  </rte>

